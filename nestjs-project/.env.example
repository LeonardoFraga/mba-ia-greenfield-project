# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO locally, S3-compatible in production)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_BUCKET_VIDEOS=videos
STORAGE_BUCKET_THUMBNAILS=thumbnails
# Browser-reachable base URL for public thumbnail URLs. This is the one place a
# host URL is correct instead of the Compose service name: the value is handed
# to a browser, not used for container-to-container traffic.
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_PRESIGN_TTL_SECONDS=900
STORAGE_UPLOAD_PART_SIZE_BYTES=52428800
STORAGE_MAX_UPLOAD_BYTES=10737418240
STORAGE_ABANDONED_UPLOAD_CUTOFF_HOURS=24

# Queue (BullMQ 6 on Redis)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_VIDEO_PROCESSING_NAME=video-processing
# Exhausting these attempts is what moves a video to `failed`.
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY_MS=1000
