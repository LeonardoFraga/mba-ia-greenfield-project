{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "dotenv/config",
    "<rootDir>/../src/test/jest-queue-namespace.ts",
    "<rootDir>/../src/test/jest-storage-public-url.ts"
  ],
  "maxWorkers": 1
}
